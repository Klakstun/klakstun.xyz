// 修改：仅限制大小，不限制格式
async function handleAiUpload(request, env) {
  // 1. 请求体大小硬限制：不能超过 2MB
  const contentLength = parseInt(request.headers.get("content-length"), 10);
  if (contentLength && contentLength > 2 * 1024 * 1024) {
    return aiJson({ error: "Payload too large. Maximum size is 2MB." }, 413);
  }

  let body;
  try {
    body = await request.json();
  } catch {
    return aiJson({ error: "Invalid JSON format. Only JSON is allowed." }, 400);
  }

  // 2. 强制要求必须有 text 字段 (支持纯文本或 Base64 等任何字符串)
  if (!body || typeof body.text !== "string") {
    return aiJson({ error: "Missing 'text' field. Must be a string." }, 400);
  }

  // 3. 字符数硬限制（约 1MB 内容，防止内存撑爆）
  if (body.text.length > 1000000) {
    return aiJson({ error: "Text content too large. Max 1,000,000 characters." }, 413);
  }

  // 4. 清理文件名并允许自定义 MIME 类型
  let fileName = body.filename;
  if (!fileName || typeof fileName !== "string") {
    fileName = "ai_output.txt";
  } else {
    fileName = fileName.slice(0, 50).replace(/[\/\\:*?"<>|]/g, "_"); 
  }
  
  // 如果 AI 没传类型，默认给 text/plain，如果传了就用 AI 传的
  const contentType = (typeof body.type === "string" && body.type) ? body.type : "text/plain; charset=utf-8";

  const textContent = body.text;
  
  // 公共接口强制降级：只保留 1 小时，仅允许下载 1 次
  const ttlHours = 1; 
  const maxDownloads = 1;
  const expiresAt = Date.now() + ttlHours * HOUR_MS;
  const token = genToken();

  try {
    await env.BUCKET.put(`file_${token}`, textContent, {
      httpMetadata: { contentType }, // 使用动态传入的 contentType
      customMetadata: { fileName },
    });
    await putState(env, token, maxDownloads, expiresAt, maxDownloads);
  } catch (e) {
    await purge(env, token);
    return aiJson({ error: "Failed to store file." }, 500);
  }

  const origin = new URL(request.url).origin;

  return aiJson({
    success: true,
    token,
    downloadUrl: `${origin}/download?token=${token}`,
    message: "File generated. Note: Public API files expire in 1 hour."
  });
}